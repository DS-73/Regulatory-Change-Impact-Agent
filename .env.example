# Copy to .env and add your key. Without a key the app runs in mock (rule-based) mode.
OPENROUTER_API_KEY=
# Optional overrides of config/llm.yaml. One model does extraction, clause pairing and the control Q&A.
REGWATCH_MODEL=google/gemma-4-31b-it:free
# Used only if the primary is rate-limited or unavailable.
REGWATCH_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# --- Security ---
# Require a password before the dashboard loads (leave empty for open local demo).
REGWATCH_APP_PASSWORD=
# Redact emails, phone numbers, IBANs and card numbers before any LLM call (1 = on).
REGWATCH_REDACT_PII=1
# Maximum upload size in MB (keep in sync with .streamlit/config.toml maxUploadSize).
REGWATCH_MAX_UPLOAD_MB=15
